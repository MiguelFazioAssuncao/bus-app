{
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bus-app-api-0nql.onrender.com/:path*"
    },
    {
      "source": "/((?!api/|assets/|bus-icon\\.svg|favicon\\.ico|bus1\\.png|bus2\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
